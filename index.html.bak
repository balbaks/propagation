<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Propagation — demo</title>
  <style>
    body { margin: 0; font-family: system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial; background: #000; color: #fff; display: flex; align-items: center; justify-content: center; height: 100vh; }
    .card { max-width: 980px; width: 92%; text-align: center; }
    img { width: 100%; height: auto; border-radius: 12px; box-shadow: 0 8px 30px rgba(0,0,0,0.6); }
    a.button { display: inline-block; margin-top: 18px; padding: 10px 18px; background: linear-gradient(90deg,#3a7bff,#9b59ff); color: white; text-decoration: none; border-radius: 8px; font-weight: 600; }
    p.lead { color: #bcd; }
  </style>
</head>
<body>
  <div class="card">
    <h1>Propagation</h1>
    <p class="lead">Interactive node/signal network demo (three.js). Click the demo button to open the full-screen simulation.</p>
    <img src="assets/screenshot.svg" alt="Propagation demo screenshot">
    <div>
      <a class="button" href="/propagation.html">Open demo</a>
      <a class="button" href="https://github.com/balbaks/propagation" style="margin-left:12px;background:#222;border:1px solid #444;">Repository</a>
    </div>
  </div>
</body>
</html>
